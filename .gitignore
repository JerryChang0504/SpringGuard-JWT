# =========================
# Java / Maven 編譯輸出
# =========================
target/
out/
build/

# 已編譯的位元組碼與套件檔（通常由 CI/CD 產生，不建議入版控）
*.class
*.jar
*.war
*.nar
*.ear

# =========================
# 記錄檔與執行期暫存
# =========================
*.log
logs/
*.pid
*.seed
*.out
*.err

# JVM 異常傾印檔
hs_err_pid*
replay_pid*

# =========================
# IDE / 編輯器設定（本機個人化）
# =========================

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# Eclipse / STS
.project
.classpath
.factorypath
.settings/

# =========================
# 作業系統產生檔案
# =========================
.DS_Store
Thumbs.db

# =========================
# 環境變數與密鑰（避免敏感資訊外洩）
# =========================
.env
.env.*
!.env.example

# =========================
# 測試或臨時資料夾
# =========================
tmp/
temp/
